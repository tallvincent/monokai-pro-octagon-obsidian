{
	"name": "monokai-pro-octagon-theme",
	"version": "1.1.1",
	"scripts": {
		"build": "sass --no-source-map --style=expanded scss/main.scss theme.css",
		"watch": "sass --no-source-map --style=expanded --watch scss/main.scss:theme.css",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "npm run build && stylelint theme.css"
	},
	"devDependencies": {
		"sass": "^1.89.2",
		"stylelint": "^17.16.0",
		"stylelint-config-obsidianmd": "^0.1.0"
	}
}
